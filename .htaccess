# ================================================================
# FILE: .htaccess (root)
# PURPOSE: Security headers, directory protection, error pages
# ================================================================

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block sensitive directories from direct access
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^sql/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^lang/ - [F,L]
    RewriteRule ^docs/ - [F,L]
</IfModule>

# Disable directory listing
Options -Indexes

# Block sensitive files
<FilesMatch "\.(sql|log|ini|env|bak|old|tmp|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect .htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Custom error pages
ErrorDocument 404 /matjar_el_kotobia/errors/404.php
ErrorDocument 500 /matjar_el_kotobia/errors/500.php

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
